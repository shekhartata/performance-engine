<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Performance Envelope — {{ report.executive_summary.run_id }}</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; margin: 2rem; color: #222; }
    h1, h2 { color: #0b3d91; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    img { max-width: 100%; border: 1px solid #ddd; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid #ccc; padding: 0.4rem 0.6rem; font-size: 0.9rem; }
    th { background: #f4f6fb; }
    .pill { display: inline-block; padding: 0.1rem 0.5rem; border-radius: 999px; background: #eef; }
    pre { background: #f7f7f7; padding: 0.8rem; overflow: auto; }
  </style>
</head>
<body>
  <h1>Performance Envelope Report</h1>
  <p>Run <span class="pill">{{ report.executive_summary.run_id }}</span>
     Confidence <span class="pill">{{ report.confidence }}</span></p>

  <h2>Executive Summary</h2>
  <ul>
    <li>Models: {{ report.data_model | join(', ') }}</li>
    <li>MAPE: {{ report.executive_summary.validation.mape if report.executive_summary.validation else 'n/a' }}</li>
    <li>Prediction model: {{ report.executive_summary.prediction_model or 'n/a' }}</li>
  </ul>

  <h2>Run settings</h2>
  <p>Values the engine set for this run. Source is user, default, or derived.</p>
  <table>
    <tr><th>Setting</th><th>Value</th><th>Source</th><th>Formula</th></tr>
    {% for row in report.run_settings.run or [] %}
    <tr>
      <td>{{ row.setting }}</td>
      <td><code>{{ row.value | tojson }}</code></td>
      <td>{{ row.source }}</td>
      <td>{{ row.formula or '' }}</td>
    </tr>
    {% endfor %}
  </table>

  <h3>Connection pool</h3>
  <ul>
    {% for line in report.pool_lines or [] %}
    <li>{{ line }}</li>
    {% endfor %}
  </ul>

  {% if report.run_settings.cells %}
  <h3>Per test case</h3>
  <table>
    <tr>
      <th>Model</th><th>Rep</th><th>Database</th><th>Pool</th>
      <th>Peak in use</th><th>Pool wait p95 ms</th><th>Parallel steps</th>
      <th>Warmup</th><th>Client CPU %</th>
    </tr>
    {% for cell in report.run_settings.cells %}
    <tr>
      <td>{{ cell.model }}</td>
      <td>{{ cell.repetition }}</td>
      <td>{{ cell.database }}</td>
      <td>{{ cell.pool.formula }}</td>
      <td>{{ cell.pool.peak_in_use }}</td>
      <td>{{ cell.pool.wait_p95_ms }}</td>
      <td>{{ cell.parallel_steps }}</td>
      <td>{{ cell.warmup }}</td>
      <td>{{ cell.client_cpu_pct }}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}
  <p>Rendered pipelines and sampled parameter values are in <code>configuration/run_settings.json</code>.</p>

  <h2>Query</h2>
  <pre>{{ report.access_pattern | tojson(indent=2) }}</pre>

  <h2>Thresholds</h2>
  {% set table = report.threshold_table %}
  {% if table and table.rows %}
  <p>Largest {{ table.axis }} whose p95 stays within the SLO, for each combination of the other varied settings.</p>
  <table>
    <tr>
      {% for name in table.group_names %}<th>{{ name }}</th>{% endfor %}
      <th>Largest {{ table.axis }} meeting SLO</th><th>p95 there (ms)</th><th>First failing {{ table.axis }}</th>
    </tr>
    {% for row in table.rows %}
    <tr>
      {% for value in row.groups %}<td>{{ value }}</td>{% endfor %}
      <td>{{ row.max_meeting_slo if row.max_meeting_slo is not none else 'none' }}</td>
      <td>{{ row.p95_ms if row.p95_ms is not none else 'n/a' }}</td>
      <td>{{ row.first_fail if row.first_fail is not none else 'none tested' }}</td>
    </tr>
    {% endfor %}
  </table>
  {% else %}
  <p>No threshold goal was set.</p>
  {% endif %}

  <h2>Performance Surface</h2>
  <div class="grid">
    {% for key, b64 in report.plots.items() %}
      {% if b64 %}
      <figure>
        <img src="data:image/png;base64,{{ b64 }}" alt="{{ key }}" />
        <figcaption>{{ key }}</figcaption>
      </figure>
      {% endif %}
    {% endfor %}
  </div>

  <h2>Observed Boundary</h2>
  {% if report.averaged_over %}
  <p>This section and Model Comparison summarize by dataset size and average over {{ report.averaged_over | join(', ') }}. The Thresholds table gives results for each condition.</p>
  {% endif %}
  <pre>{{ report.observed_boundary | tojson(indent=2) }}</pre>

  <h2>What drives latency</h2>
  {% set attribution = report.attribution %}
  {% if attribution and attribution.rows %}
  <p>{{ attribution.explanation }}</p>
  <table>
    <tr><th>Setting</th><th>Share</th></tr>
    {% for row in attribution.rows %}
    <tr><td>{{ row.name }}</td><td>{{ row.share }}%</td></tr>
    {% endfor %}
  </table>
  <p>A row like "A × B" is the extra effect of A and B together: how much the effect of one changes with the other.</p>
  {% else %}
  <p>{{ attribution.explanation if attribution else 'Not available.' }}</p>
  {% endif %}
  {% if attribution and attribution.held_fixed %}
  <p>Held fixed (not varied, so not ranked):
    {% for name, value in attribution.held_fixed.items() %}{{ name }} = {{ value }}{% if not loop.last %}, {% endif %}{% endfor %}.</p>
  {% endif %}
  {% if attribution and attribution.notes %}
  <ul>
    {% for note in attribution.notes %}<li>{{ note }}</li>{% endfor %}
  </ul>
  {% endif %}

  <h2>Diagnostics</h2>
  <ul>
    {% for item in report.diagnostics or [] %}
    <li><strong>{{ item.observation }}</strong> — {{ item.evidence }} ({{ item.hypothesis }}, {{ item.confidence }})</li>
    {% endfor %}
  </ul>

  <h2>Model Comparison</h2>
  {% if report.averaged_over %}<p>Averaged over {{ report.averaged_over | join(', ') }}.</p>{% endif %}
  <pre>{{ report.model_comparison | tojson(indent=2) }}</pre>

  <h2>Scale curves</h2>
  <p>One measured curve per dataset size. Projected sizes are tagged <code>extrapolated: true</code>.</p>
  <pre>{{ report.scale_curves | tojson(indent=2) }}</pre>
  <pre>{{ report.projection | tojson(indent=2) }}</pre>

  <h2>Limitations</h2>
  <ul>
    {% for item in report.limitations %}
    <li>{{ item }}</li>
    {% endfor %}
  </ul>
</body>
</html>
