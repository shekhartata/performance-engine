<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Performance Envelope — {{ report.executive_summary.run_id }}</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; margin: 2rem; color: #222; }
    h1, h2 { color: #0b3d91; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    img { max-width: 100%; border: 1px solid #ddd; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid #ccc; padding: 0.4rem 0.6rem; font-size: 0.9rem; }
    th { background: #f4f6fb; }
    .pill { display: inline-block; padding: 0.1rem 0.5rem; border-radius: 999px; background: #eef; }
    pre { background: #f7f7f7; padding: 0.8rem; overflow: auto; }
  </style>
</head>
<body>
  <h1>Performance Envelope Report</h1>
  <p>Run <span class="pill">{{ report.executive_summary.run_id }}</span>
     Confidence <span class="pill">{{ report.confidence }}</span></p>

  <h2>Executive Summary</h2>
  <ul>
    <li>Models: {{ report.data_model | join(', ') }}</li>
    <li>MAPE: {{ report.executive_summary.validation.mape if report.executive_summary.validation else 'n/a' }}</li>
  </ul>

  <h2>Performance Surface</h2>
  <div class="grid">
    {% for key, b64 in report.plots.items() %}
      {% if b64 %}
      <figure>
        <img src="data:image/png;base64,{{ b64 }}" alt="{{ key }}" />
        <figcaption>{{ key }}</figcaption>
      </figure>
      {% endif %}
    {% endfor %}
  </div>

  <h2>Observed Boundary</h2>
  <pre>{{ report.observed_boundary | tojson(indent=2) }}</pre>

  <h2>Sensitivity</h2>
  <table>
    <tr><th>Factor</th><th>Relative influence</th></tr>
    {% for name, value in (report.sensitivity_analysis or {}).items() %}
    <tr><td>{{ name }}</td><td>{{ value }}%</td></tr>
    {% endfor %}
  </table>

  <h2>Diagnostics</h2>
  <ul>
    {% for item in report.diagnostics or [] %}
    <li><strong>{{ item.observation }}</strong> — {{ item.evidence }} ({{ item.hypothesis }}, {{ item.confidence }})</li>
    {% endfor %}
  </ul>

  <h2>Model Comparison</h2>
  <pre>{{ report.model_comparison | tojson(indent=2) }}</pre>

  <h2>Scale curves</h2>
  <p>One measured curve per dataset size. Projected sizes are tagged <code>extrapolated: true</code>.</p>
  <pre>{{ report.scale_curves | tojson(indent=2) }}</pre>
  <pre>{{ report.projection | tojson(indent=2) }}</pre>

  <h2>Limitations</h2>
  <ul>
    {% for item in report.limitations %}
    <li>{{ item }}</li>
    {% endfor %}
  </ul>
</body>
</html>
